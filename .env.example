# Copie este arquivo para ".env" e cole sua chave abaixo.
# NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).

# Chave da API da Anthropic (https://console.anthropic.com/). Deixe vazio para rodar só com regras.
ANTHROPIC_API_KEY=

# Modelo usado quando o bot não souber responder por regras (opcional).
ANTHROPIC_MODEL=claude-haiku-5-5

# Arquivo do banco SQLite (opcional).
DB_PATH=atendimento.db
